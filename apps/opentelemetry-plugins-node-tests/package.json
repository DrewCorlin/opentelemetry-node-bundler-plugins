{
  "name": "@opentelemetry-bundler-plugins/tests",
  "version": "0.0.1",
  "license": "MIT",
  "nx": {
    "targets": {
      "test": {
        "executor": "nx:run-commands",
        "outputs": [
          "{options.outputPath}"
        ],
        "dependsOn": [
          "^build"
        ],
        "options": {
          "cwd": "apps/opentelemetry-plugins-node-tests",
          "command": "nyc node --require ts-node/register --test 'test/**/*.test.ts'",
          "outputPath": "packages/opentelemetry-plugins-node-tests/test-dist"
        }
      },
      "clean": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/opentelemetry-plugins-node-tests",
          "command": "rm -rf test-dist"
        }
      }
    }
  },
  "devDependencies": {
    "@babel/preset-env": "^8.0.2",
    "@fastify/rate-limit": "^11.2.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/instrumentation-fastify": "^0.57.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^24.0.0",
    "@types/webpack": "^5.28.5",
    "babel-loader": "^10.1.1",
    "esbuild": "^0.28.2",
    "fastify": "5.11.3",
    "graphql": "^17.0.2",
    "mongodb": "7.5.0",
    "mongodb-memory-server": "11.2.0",
    "nyc": "18.0.0",
    "pino": "^10.3.1",
    "prettier": "3.9.6",
    "redis": "^4.7.1",
    "rolldown": "^1.2.3",
    "rollup": "^4.62.4",
    "terser-webpack-plugin": "^5.6.1",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.0",
    "webpack": "^5.109.2"
  }
}
